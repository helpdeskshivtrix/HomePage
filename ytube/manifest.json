{
  "name": "Youtube ShivTrix",
  "short_name": "YouTrix",
  "description": "ShivTrix Youtube YouTube metadata library and player",
  "lang": "en",
  "dir": "ltr",

  "id": "./",
  "start_url": "./index.html",
  "scope": "./",

  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",

  "theme_color": "#030407",
  "background_color": "#030407",

  "categories": ["music", "video", "entertainment"],
  "prefer_related_applications": false,

  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
